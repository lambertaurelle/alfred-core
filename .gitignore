# ==============================================================================
# ALFRED V8.0 — MONO-REPO ZERO UPSTREAM LEAK INVARIANT (.gitignore)
# ==============================================================================
worktrees/
.venv/
venv/
ENV/

# Instance overlay: ignore all private data/secrets/active configs & active extensions,
# while allowing versioned *.example.* templates, extension contract, and instance/examples/.
instance/*
!instance/config/
instance/config/*
!instance/config/*.example.yaml
!instance/config/*.example.yml
!instance/config/prompts/
instance/config/prompts/*
!instance/config/prompts/*.example.md
!instance/extensions/
instance/extensions/*
!instance/extensions/__init__.py
!instance/extensions/README.md
!instance/extensions/*.example.py
!instance/examples/

# Private & runtime artifacts anywhere in the tree
instance/data/
instance/secrets/
secrets/
**/secrets/
**/signature_vault/
**/cache/
*.lock
*.env
*.env.*
!*.env.example
*.pem
*.key
*.token
*.enc
credentials*.json
client_secret*.json
token*.json
mcp_auth*.json

# Python build, test & cache artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# OS & editor files
.DS_Store
*.swp
*.tmp
*.log
