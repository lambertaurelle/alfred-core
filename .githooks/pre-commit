#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${REPO_ROOT}"
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY

VENV_DIR="${REPO_ROOT}/.venv"
if [[ ! -d "${VENV_DIR}" ]]; then
    COMMON_GIT_DIR="$(git rev-parse --git-common-dir 2>/dev/null || true)"
    if [[ -n "${COMMON_GIT_DIR}" ]]; then
        MAIN_ROOT="$(cd "${COMMON_GIT_DIR}/.." && pwd)"
        if [[ -d "${MAIN_ROOT}/.venv" ]]; then
            VENV_DIR="${MAIN_ROOT}/.venv"
        fi
    fi
fi

PYTHON_BIN="${VENV_DIR}/bin/python"
if [[ ! -x "${PYTHON_BIN}" ]]; then
    PYTHON_BIN="python3"
fi

echo "[Alfred Gate 1/5] Checking Clean Architecture OOP & Line Limits..."
"${PYTHON_BIN}" "${REPO_ROOT}/core/scripts/check_code_architecture.py"

echo "[Alfred Gate 2/5] Checking Zero Personal Data Leak..."
bash "${REPO_ROOT}/core/scripts/check-upstream-leak.sh" "${REPO_ROOT}"

if [[ -x "${VENV_DIR}/bin/ruff" ]]; then
    echo "[Alfred Gate 3/5] Running Ruff..."
    "${VENV_DIR}/bin/ruff" check core
fi

if [[ -x "${VENV_DIR}/bin/mypy" ]]; then
    echo "[Alfred Gate 4/5] Running Mypy (--strict)..."
    "${VENV_DIR}/bin/mypy" --strict core/alfred core/scripts
fi

if [[ -x "${VENV_DIR}/bin/pytest" ]]; then
    echo "[Alfred Gate 5/5] Running Pytest TDD Coverage (>= 90%)..."
    "${VENV_DIR}/bin/pytest" --cov=core --cov-fail-under=90
fi

if [[ -f "${REPO_ROOT}/docs/SPEC.md" ]]; then
    echo "[Alfred Gate 6/6] Checking Living Spec Sync (docs/SPEC.md)..."
    PYTHONPATH="${REPO_ROOT}/core" ALFRED_ROOT_DIR="${REPO_ROOT}" \
        "${PYTHON_BIN}" -m alfred.main sync-spec --check --repo-root "${REPO_ROOT}"
fi

echo "[Alfred Pre-Commit] All deterministic gates passed."
